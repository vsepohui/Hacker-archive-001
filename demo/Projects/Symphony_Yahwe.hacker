#my @c = sample ('../Samples/sound_keyboard_staff/c1.mp3')->play(12);

my @e4 = crop sample ('../Samples/sound_keyboard_staff/e1.mp3')->play(12), 0.8;
my @b6 = crop sample ('../Samples/sound_keyboard_staff/b3.mp3')->play(12), 0.8;

my @f5 = crop sample ('../Samples/sound_keyboard_staff/f2.mp3')->play(12), 0.8;
my @b4 = crop sample ('../Samples/sound_keyboard_staff/b1.mp3')->play(12), 0.8;

my @e5 = crop sample ('../Samples/sound_keyboard_staff/e2.mp3')->play(12), 0.8;
my @a4 = crop sample ('../Samples/sound_keyboard_staff/a1.mp3')->play(12), 0.8;



mix (

	# MAIN THEME (FIRST PIANO)
	[
		(
			mix (
				[(@e4, silence 0.3) x 16],
				[silence (0.4), ((@b6, silence 0.3) x 16)]
			)
		) x 4
	],
	
	# SOLO (SECOND PIANO)
	[
		(
			(
				(@f5, silence 0.3), 
				(@e5, silence 0.3)
			) x 64
		)
	],
	[
		silence (0.4),
		(
			(
				(@b4, silence 0.3), 
				(@a4, silence 0.3)
			) x 64
		)
	],
);


