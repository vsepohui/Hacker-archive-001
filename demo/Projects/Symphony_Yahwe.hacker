sub piano {
	my $note = shift;
	return sample ("../Samples/sound_keyboard_staff/$note.mp3")->play(0)
}

my @e4 = crop piano('e1'), 0.8;
my @b6 = crop piano('b3'), 0.8;

my @f5 = crop piano('f2'), 0.8;
my @b4 = crop piano('b1'), 0.8;

my @e5 = crop piano('e2'), 0.8;
my @a4 = crop piano('a1'), 0.8;



mix (

	# MAIN THEME (FIRST PIANO)
	[
		(
			mix (
				[(@e4, silence 0.3) x 16],
				[silence (0.4), ((@b6, silence 0.3) x 16)]
			)
		) x 4
	],
	
	# SOLO (SECOND PIANO)
	[
		(
			(
				(@f5, silence 0.3), 
				(@e5, silence 0.3)
			) x 64
		)
	],
	[
		silence (0.4),
		(
			(
				(@b4, silence 0.3), 
				(@a4, silence 0.3)
			) x 64
		)
	],
);


