my @sample = sine 'C6', 5;
my @c = sine 'C8', 5;
my @c4 = sine 'C6', 5;

my $bpm = 210;

my @_am	= crop (git (\@sample, 'x,0,2,2'), 1); 
my @_f	= crop (git (\@sample, '1,3,3'), 1);
my @_c	= crop (git (\@sample, 'x,3,2,0'), 1);
my @_e 	= crop (git (\@sample, '0,2,2'), 1);

my @bass	= chip (((seq (\@c4, $bpm,'-3,-3,-3,-3,-7,-7,-7,-7,0,0,0,0,-8,-8,-8,-8'))x16));
my @rythm  	= distortion (((seq (\@_am, $bpm, '0,#,0,0,0'), seq (\@_f, $bpm, '0,#,0,0,0'), seq (\@_c, $bpm, '0,0,0,0,0'), seq (\@_e, $bpm, '0,.,0,0,0')) x 16), 0.9);
my @solo  	= distortion (((seq (\@c, $bpm, '0,#,0,-1,0,#,0,-1,0,-1,-3,-5,#,0,-1')) x 32), 0.1);

eq ((
	mix 
		\@bass, 
		\@rythm, 
		[gain @solo, 0.7],
		[speech (q[

Granicy kljuch perelomlen popolam,
A nash batjushka Lenin sovsem usop,
On razlozhilsja na plesen' i na lipovyj mjod,
A perestrojka vse idjot i idjot po planu,
A vsja grjaz' prevratilas' v golyj ljod.
I vsjo idjot po planu.
A moja dusha zahotela na pokoj,
Ja obeshhal ej ne uchastvovat' v voennoj igre,
No na furazhke na moej serp i molot i zvezda,
Kak jeto trogatel'no serp i molot i zvezda,
Lihoj fonar' ozhidanija motaetsja,
I vsjo idjot po planu...
Vsjo idjot po planu...
A moej zhenoj nakormili tolpu,
Mirovym kulakom rastoptali ej grud',
Vsenarodnoj svobodoj rasterzali ej plot',
Tak zakopajte zh ejo vo Hriste! Ved'
Vsjo idjot po planu...
Vsjo idjot po planu...
Odin lish' dedushka Lenin horoshij byl vozhd',
A vse drugie ostal'nye takoe der'mo,
A vse drugie vragi takie duraki,
Nad rodnoju nad otchiznoj besnovatyj sneg shjol,
Ja kupil zhurnal Koreja tam tozhe horosho,
Tam tovarishh Kim Ir Sen, tam tozhe chto u nas,
Ja uveren chto u nih tozhe samoe
I vsjo idjot po planu...
Vsjo idjot po planu...
A pri kommunizme vse budet zae.is',
On nastupit skoro, nado tol'ko podozhdat',
Tam vse budet besplatno, tam vsjo budet v kajf,
Tam navernoe voobshhe ne nado budet umirat',
Ja prosnulsja sredi nochi i ponjal, chto
Vsjo idet po planu...
Vsjo idet po planu...		
		
		])->play(-36)],
	), {
	low_freq 	=> 880,
	high_freq 	=> 5000,
	low_gain 	=> 0.1,
	mid_gain	=> 1.0,
	high_gain	=> 0.1,
});
